.venv/
# API credentials. .env.example is the committed template; .env never is.
.env
.cache/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.cache/
data/raw/
*.ipynb_checkpoints

# Run outputs: keep the small, reviewable artefacts (manifests, analysis JSON,
# the calibration verdict, the cost profile and the visibility sweep) and ignore
# the bulk logs, which ./reproduce.sh regenerates in seconds. The kept files are
# exactly what paper/build_tables.py reads, so the paper builds from a clone.
runs/**
!runs/.gitkeep
!runs/*/
!runs/*/manifest.json
!runs/*/calibration.json
# The gate sweep is twelve near-identical seeds; its verdict lives in
# docs/CALIBRATION.md, so the per-seed files are not worth carrying.
runs/gate_*/
!runs/*/checks.json
!runs/*/sweep.json
!runs/*/cost.json
!runs/*/analysis/
!runs/*/analysis/analysis.json
!runs/*/analysis/*.csv
!runs/*/figures/
!runs/*/figures/**
node_modules/
package-lock.json

# Understand-Anything scratch (code-map tooling, not part of the study).
# Kept locally because scan-result.json lets a re-run skip its scan phase.
.ua/
